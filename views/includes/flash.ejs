<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x text-center shadow" role="alert" style="z-index: 1050; margin-top: 20px; min-width: 300px;">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x text-center shadow" role="alert" style="z-index: 1050; margin-top: 20px; min-width: 300px;">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>